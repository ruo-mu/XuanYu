.DS_Store
Thumbs.db

# Editor / local agent state (do not commit)
.cursor/
.idea/
.vscode/
.trae/
!.vscode/extensions.json
!.vscode/settings.json

# Dependencies & package caches
node_modules/
.pnpm-store/
.turbo/
.vite/
.playwright-cli/

# Build outputs
dist/
build/
target/

# electron-builder installer assets (build INPUTS: NSIS script, EULA, icons) — required to build the setup exe
!apps/desktop/build/
coverage/
plugins-res/**/index.js
apps/desktop-ui/.vite/
apps/desktop-ui/dist/
apps/desktop-ui/dist-setup/
apps/desktop/out/
apps/desktop/release/
apps/desktop/release-dist/
# Accidental numeric empty files from shell redirects (e.g. 2916, 4044)
apps/desktop/[0-9]*
*.tsbuildinfo

# Legacy NSIS installer removed (replaced by electron-builder in apps/desktop)

# Native & Python workers (sources tracked; binaries & cmake output ignored)
workers/inference-cpp/build*/
workers/agent-python/dist/
workers/agent-python/build/
workers/agent-python/.venv/
workers/agent-python/**/*.spec

# Tauri generated schemas (regenerated by `tauri build`)
crates/*/gen/

# Local app data & migration scratch
.xuanyu/

# CodeGraph index
.codegraph/

# Secrets & signing keys
.env
.env.*
!.env.example
*.key
!*.key.pub
updater.key

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs & temp
*.log
*.tmp
*.bak
*.swp
*~

# OS / tooling noise
*.pdb
*.ilk
*.exp
